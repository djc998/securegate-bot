# SecureGate Telegram SaaS Bot Config Template

# 1. Core Telegram Credentials
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Deployment Mode
# "PUBLIC"     -> Enable /setup command, require group registration, Stripe billing paywall
# "WHITELABEL" -> Fixed routing, disable public invoice billing and setup command
DEPLOYMENT_MODE=WHITELABEL

# 3. Security Limits
TIME_LIMIT_SECONDS=300

# 4. Premium Bypass Promo Code (Allows free premium upgrade using: /premium BYPASS_CODE)
PREMIUM_BYPASS_CODE=BYPASS123

# 5. Whitelabel Custom Settings (Used only if DEPLOYMENT_MODE=WHITELABEL)
CLIENT_OWNER_ID=123456789
CLIENT_GROUP_CHAT_ID=-1001234567890
